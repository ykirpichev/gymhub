# Settings for deploy/pool/compose.controller.yml: copy to deploy/pool/.env and fill in.

# The address machines and members reach the pool server at (your LAN address, or an HTTPS proxy).
POOL_PUBLIC_URL=http://192.168.1.10:8765
# Listen only there (default: every interface).
#POOL_BIND=192.168.1.10

# The board the dispatcher leases jobs from: its worker URL (`deploy/gcp.sh status`) and a worker token
# from its Compute page. Or, for a board on this machine, GYMHUB_STORE=sqlite:/state/board.db.
#GYMHUB_API=https://gymhub-board-workers-xxxx-uc.a.run.app
#GYMHUB_WORKER_TOKEN=

# The pool member the dispatcher submits as. Or leave it empty and run `pool login` once (docs/pool.md).
#POOL_TOKEN=

# Pin images to a build (default: the latest ones CI published), or use your own.
#POOL_IMAGE=ghcr.io/ykirpichev/gymhub/pool:latest
#DISPATCHER_IMAGE=ghcr.io/ykirpichev/gymhub/dispatcher:latest
