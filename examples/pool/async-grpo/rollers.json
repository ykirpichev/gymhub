{
  "name": "roller",
  "image": "pool/rl-spike:verl",
  "command": ["python", "roller.py"],
  "code": ".",
  "inputs": [{"path": "base", "model": "qwen0.5b@instruct"}],
  "subscribe": ["POLICY_NAME"],
