# Spike S1 (issue #45): prime-rl from its lock file (torch 2.14 cu130, vLLM 0.34, arm64 wheels on PyPI).
# Everything is downloaded at build time; jobs run with --network none.
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3.12 python3.12-dev python3.12-venv git curl ca-certificates build-essential \
 && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
ENV UV_PYTHON=python3.12 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/prime-rl/.venv
RUN git config --global url."https://github.com/".insteadOf "git@github.com:" && git clone https://github.com/PrimeIntellect-ai/prime-rl /opt/prime-rl && cd /opt/prime-rl && git checkout 1c21178469aee8a3c5894107ea93fd6499c86e28 && git submodule update --init --recursive
WORKDIR /opt/prime-rl
RUN uv sync --extra gpu --extra flash-attn --no-dev
# The reverse-text taskset (environments are opt-in workspace members). No chmod -R: it would copy the
# whole 35 GB venv into a second layer; files are already world-readable.
RUN uv pip install --python /opt/prime-rl/.venv/bin/python --no-deps -e deps/verifiers/environments/reverse_text
# The inference launcher fronts vLLM with vllm-router (in the optional "disagg" extra).
RUN ARCH=$(uname -m) && uv pip install --python /opt/prime-rl/.venv/bin/python --no-deps \
      "https://github.com/PrimeIntellect-ai/router/releases/download/v0.2.8/vllm_router-0.2.8-cp38-abi3-manylinux_2_28_${ARCH}.whl"
# verifiers' harness bootstraps its program with `uv sync --script` at run time (openai, mcp, httpx2, ...).
# Jobs have no network, so the wheels are fetched now and uv is pointed at them, never at an index.
RUN python3.12 -m venv /tmp/dl && /tmp/dl/bin/pip download -q -d /opt/wheels \
      openai "mcp==2.3.0" httpx httpx2 tenacity certifi && rm -rf /tmp/dl && chmod -R a+rX /opt/wheels
# uv ignores UV_NO_INDEX for `sync --script`, so a wrapper first on PATH adds the flags.
RUN mkdir -p /opt/pool-bin && printf '#!/bin/sh\nif [ "$1" = sync ]; then shift; exec /usr/local/bin/uv sync --no-index --find-links /opt/wheels "$@"; fi\nexec /usr/local/bin/uv "$@"\n' > /opt/pool-bin/uv && chmod 755 /opt/pool-bin/uv
ENV PATH=/opt/pool-bin:/opt/prime-rl/.venv/bin:$PATH HOME=/tmp HF_HUB_OFFLINE=1 PYTHONUNBUFFERED=1 WANDB_MODE=disabled \
    UV_FIND_LINKS=/opt/wheels UV_NO_INDEX=1 UV_PYTHON_DOWNLOADS=never
